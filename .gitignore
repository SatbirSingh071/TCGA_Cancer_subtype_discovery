# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.Python
*.so

# --- Environments ---
.env
.venv
env/
venv/
ENV/
conda-meta/

# --- Jupyter ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# --- Data (large / regenerable) ---
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.h5ad
*.h5
*.tsv.gz
*.rda
*.RData

# Allow small, versioned metadata / demo assets to be tracked
!data/metadata/*.csv
!data/metadata/*.json
!data/metadata/*.txt

# --- Results / figures that are regenerated by the pipeline ---
# (Tracked in this repo on purpose so the README renders without a full re-run;
#  uncomment the lines below if you prefer a clean, regenerate-on-clone repo)
# figures/*
# !figures/.gitkeep
# results/*
# !results/.gitkeep

# --- Logs ---
logs/
*.log

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE ---
.vscode/
.idea/
*.swp

# --- Test / lint caches ---
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Docker ---
*.pid

# --- Secrets ---
.env.local
gdc_token.txt
*.token
